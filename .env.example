# Projet Supabase d'ADAM. La clé anon est publique par nature :
# tout l'accès aux données est décidé par la RLS et par les vues dashboard_*,
# qui n'ouvrent leurs agrégats qu'aux comptes profiles.is_admin = true.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<clé anon>

# Développement uniquement. À 1, le dashboard s'ouvre sans authentification sur des
# données inventées (src/data/fixtures.ts), sous un bandeau d'avertissement, pour
# pouvoir observer les cas limites que la base réelle ne produit pas sur commande :
# cohorte vide, ratio calculé sur un seul actif, phase avant lancement.
# Ignoré dans un build de production (garde import.meta.env.DEV).
VITE_DASHBOARD_FIXTURES=0
